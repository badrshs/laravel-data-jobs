{
    "name": "badrshs/laravel-data-jobs",
    "description": "A Laravel package for managing and executing data migration jobs with tracking and priority support",
    "type": "library",
    "keywords": [
        "laravel",
        "data-jobs",
        "migration",
        "data-migration",
        "job-runner",
        "laravel-package",
        "database-migration"
    ],
    "homepage": "https://github.com/badrshs/laravel-data-jobs",
    "license": "MIT",
    "authors": [
        {
            "name": "Badr",
            "email": "badr@badrshs.com"
        }
    ],
    "support": {
        "issues": "https://github.com/badrshs/laravel-data-jobs/issues",
        "source": "https://github.com/badrshs/laravel-data-jobs"
    },
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Badrshs\\LaravelDataJobs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Badrshs\\LaravelDataJobs\\DataJobsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (file_exists('artisan')) { echo '\\n\\033[32mLaravel Data Jobs installed! Run: php artisan data-jobs:install\\033[0m\\n\\n'; }\""
        ],
        "post-update-cmd": [
            "@php -r \"if (file_exists('artisan')) { echo '\\n\\033[32mLaravel Data Jobs updated! Run migrations if needed: php artisan migrate\\033[0m\\n\\n'; }\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}